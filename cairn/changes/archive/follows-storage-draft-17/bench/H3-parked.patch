+    /// zone the same as the window's or another; one past its horizon,
+    /// or an index behind the store, walks every body.
+    #[test]
+    fn a_window_read_from_the_index_lists_what_the_walk_lists() {
+        for zone in ["UTC", "Pacific/Kiritimati", "Pacific/Pago_Pago"] {
+            let bodies = edged_calendar();
+            let bodies: Vec<&str> = bodies.iter().map(String::as_str).collect();
+            let (dir, mut backend, _) = store(&bodies);
+
+            for range in bounded_windows() {
+                assert!(backend.window_candidates("cal", &range).is_none());
+            }
+
+            index_refresh(dir.path(), zone);
+
+            for range in bounded_windows() {
+                let candidates = backend.window_candidates("cal", &range);
+                assert!(candidates.is_some(), "{zone} {range:?}");
+                let [streamed, whole] = windowed_both(&mut backend, &range);
+                assert!(!streamed.is_empty(), "{zone} {range:?}");
+                assert_eq!(streamed, whole, "{zone} {range:?}");
+            }
+
+            let past = CalendarTimeRange {
