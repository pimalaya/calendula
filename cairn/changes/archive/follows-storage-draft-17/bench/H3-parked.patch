+    /// The occurrences a windowed listing of `cal` answers over `range`,
+    /// as `event list` and `event agenda` project them, streamed and
+    /// from the whole read.
+    fn windowed_both(backend: &mut PimdirBackend, range: &CalendarTimeRange) -> [Vec<Event>; 2] {
+        let query = CalendarItemQuery {
+            range: Some(range),
+            kind: IcalFamily::Event.kind(),
+            ..Default::default()
+        };
+        let occurrences = |items: Vec<CalendarItem>| -> Vec<Event> {
+            items
+                .iter()
+                .flat_map(|item| Event::occurrences(item, Some(range)))
+                .collect()
+        };
+
+        let streamed = backend.list_items("cal", query).unwrap().items;
+        let whole = eager(backend, "cal", query).unwrap();
+        [occurrences(streamed), occurrences(whole)]
+    }
