+    fn index_refresh(dir: &std::path::Path, zone: &str) {
+        io_pimdir::client::search::PimdirIndex::open(dir)
+            .unwrap()
+            .refresh(&io_pimdir::client::search::PimdirIndexRefreshOptions {
+                now: Some(INDEX_NOW),
