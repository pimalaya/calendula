+/// How far a window read from the index is widened each way: two days,
+/// past any zone's offset from the one the index reads floating times in.
+const WINDOW_MARGIN: SignedDuration = SignedDuration::from_hours(48);
+
+/// A `YYYYMMDDTHHMMSSZ` instant moved by `by`, as RFC 3339 in UTC.
+fn widened(stamp: &str, by: SignedDuration) -> Option<String> {
+    let at = |range: std::ops::Range<usize>| stamp.get(range);
+    let rfc3339 = format!(
+        "{}-{}-{}T{}:{}:{}Z",
+        at(0..4)?,
+        at(4..6)?,
+        at(6..8)?,
+        at(9..11)?,
+        at(11..13)?,
+        at(13..15)?,
+    );
+    let instant: Timestamp = rfc3339.parse().ok()?;
+
+    Some(instant.checked_add(by).ok()?.to_string())
