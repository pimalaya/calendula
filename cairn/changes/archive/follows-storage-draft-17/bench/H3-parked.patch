+    /// The public ids of the items of `calendar` the index places in the
+    /// window `[start, end)` (`YYYYMMDDTHHMMSSZ` instants), widened by
+    /// [`WINDOW_MARGIN`] each way, or `None` unless the index answers that
+    /// window completely.
+    ///
+    /// Complete means what SEARCH §8.2 says of a `when:` query over the
+    /// widened window, plus no placement of any kind missing or
+    /// unparseable, whether or not the term reads it. The margin covers
+    /// the zone the index reads floating times and dates in, whichever it
+    /// is. The ids are a superset: the caller still answers each item
+    /// from its own body, and reads every item the index cannot place
+    /// (one with no local body, one a pending `update` repoints).
+    pub(crate) fn window_candidates(
+        &self,
+        calendar: &str,
+        start: &str,
+        end: &str,
+    ) -> Option<BTreeSet<i64>> {
+        let start = widened(start, -WINDOW_MARGIN)?;
+        let end = widened(end, WINDOW_MARGIN)?;
+        let index = PimdirIndex::open_query(&self.root).ok()?;
+
+        let query = PimdirQuery::parse(&format!("when:{start}..{end}")).ok()?;
+        let answer = index
+            .count(&self.scope(query, Some(calendar)), &search_clock())
+            .ok()?;
+        let coverage = &answer.coverage;
+        let unread = coverage
+            .local
+            .kinds
+            .values()
+            .any(|unread| unread.missing > 0 || unread.unparseable > 0);
+        if !coverage.is_complete() || unread {
+            debug!("scan calendar `{calendar}`: the index does not answer its window");
+            return None;
+        }
+
+        let found = index.occurrences_between(&start, &end).ok()?;
+        let seqs = found
+            .into_iter()
+            .filter(|occurrence| occurrence.collection == calendar)
+            .map(|occurrence| occurrence.seq)
+            .collect();
+
+        Some(seqs)
+    }
