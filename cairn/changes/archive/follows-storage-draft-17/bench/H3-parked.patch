+    /// The bounded windows an agenda or a ranged `event list` reads.
+    fn bounded_windows() -> Vec<CalendarTimeRange> {
+        let range = |start: &str, end: &str| CalendarTimeRange {
+            start: Some(start.into()),
+            end: Some(end.into()),
+        };
+
+        vec![
+            range("20260801T000000Z", "20260901T000000Z"),
+            range("20261012T000000Z", "20261019T000000Z"),
+            range("20261101T000000Z", "20261201T000000Z"),
